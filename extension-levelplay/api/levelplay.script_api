- name: levelplay
  type: table
  desc: Functions and constants for Unity LevelPlay mediation on Android and iOS.

  members:

# Callback and initialization

  - name: set_callback
    type: function
    desc: Sets the callback used for all LevelPlay events. Pass nil to remove it.
    parameters:
    - name: callback
      type: function
      optional: true
      parameters:
      - name: self
        type: object
        desc: The script instance that installed the callback.
      - name: message_id
        type: number
        desc: One of MSG_INIT, MSG_INTERSTITIAL, MSG_REWARDED, MSG_BANNER, or MSG_TRACKING.
      - name: message
        type: table
        desc: Event data. Every asynchronous SDK event contains `event`. Events from a created ad object also contain `handle`; pre-creation validation errors do not.
        fields:
        - name: event
          type: number
          desc: An EVENT_* constant, or a TRACKING_STATUS_* constant for MSG_TRACKING.
        - name: handle
          type: number
          optional: true
          desc: The ad object that emitted the event.
        - name: error_code
          type: number
          optional: true
        - name: error_message
          type: string
          optional: true
        - name: error_domain
          type: string
          optional: true
          desc: Native error domain when supplied by iOS.
        - name: operation
          type: string
          optional: true
          desc: Bridge operation associated with a validation error.
        - name: error
          type: string
          optional: true
          desc: Serialization error detail for EVENT_JSON_ERROR.
        - name: ad_quality_enabled
          type: boolean
          optional: true
          desc: Whether Ad Quality is enabled, when reported during initialization.
        - name: ad_id
          type: string
          optional: true
        - name: ad_unit_id
          type: string
          optional: true
        - name: ad_unit_name
          type: string
          optional: true
        - name: ad_format
          type: string
          optional: true
        - name: placement_name
          type: string
          optional: true
        - name: auction_id
          type: string
          optional: true
        - name: country
          type: string
          optional: true
        - name: ab
          type: string
          optional: true
        - name: segment_name
          type: string
          optional: true
        - name: ad_network
          type: string
          optional: true
        - name: instance_name
          type: string
          optional: true
        - name: instance_id
          type: string
          optional: true
        - name: revenue
          type: number
          optional: true
        - name: precision
          type: string
          optional: true
        - name: encrypted_cpm
          type: string
          optional: true
        - name: creative_id
          type: string
          optional: true
        - name: conversion_value
          type: number
          optional: true
          desc: Conversion value when supplied by iOS.
        - name: reward_name
          type: string
          optional: true
        - name: reward_amount
          type: number
          optional: true
        - name: ad_width
          type: number
          optional: true
        - name: ad_height
          type: number
          optional: true
        - name: ad_size_description
          type: string
          optional: true
        - name: ad_size_is_adaptive
          type: boolean
          optional: true

  - name: init
    type: function
    desc: Initializes LevelPlay. Configure privacy before calling this function. Create ad objects only after EVENT_INIT_SUCCEEDED.
    parameters:
    - name: app_key
      type: string
      desc: Application key from the LevelPlay dashboard. This is not an ad-unit ID.
    - name: user_id
      type: string
      optional: true
      desc: Stable application user ID included in the initialization request.

  - name: get_sdk_version
    type: function
    desc: Returns the native LevelPlay SDK version.
    returns:
    - name: version
      type: string
      optional: true

# Privacy and advanced settings

  - name: set_gdpr_consent
    type: function
    desc: Sets the user's GDPR consent choice. Call before init and map the value to a choice collected by your consent flow.
    parameters:
    - name: consent
      type: boolean

  - name: set_ccpa
    type: function
    desc: Passes a US privacy "do not sell or share" choice. True means the user opted out. Call before init.
    parameters:
    - name: opted_out
      type: boolean

  - name: set_coppa
    type: function
    desc: Sets whether the user is child-directed for COPPA treatment. True flags the user as child-directed. Call before init.
    parameters:
    - name: child_directed
      type: boolean

  - name: set_metadata
    type: function
    desc: Sets an SDK or mediated-network metadata value. Set network-required values before init.
    parameters:
    - name: key
      type: string
    - name: value
      type: string

  - name: set_meta_limited_data_use
    type: function
    desc: Configures Meta Audience Network Limited Data Use before init. This calls Meta's SDK directly and returns false if the Meta adapter is not linked or initialization already started.
    parameters:
    - name: enabled
      type: boolean
      desc: True supplies the LDU option; false clears Meta data-processing options.
    - name: country
      type: number
      optional: true
      desc: Meta country code. Zero, the default, asks Meta to geolocate.
    - name: state
      type: number
      optional: true
      desc: Meta state code. Zero, the default, asks Meta to geolocate.
    returns:
    - name: applied
      type: boolean

  - name: set_meta_advertiser_tracking
    type: function
    desc: Sets Meta Audience Network's iOS advertiser-tracking flag before init. Returns false on Android, when Meta is not linked, or after initialization starts.
    parameters:
    - name: enabled
      type: boolean
    returns:
    - name: applied
      type: boolean

  - name: set_dynamic_user_id
    type: function
    desc: Sets the dynamic user ID used by server-to-server rewarded callbacks. The value must contain 1–64 alphanumeric characters. Call before showing the rewarded ad it should apply to.
    parameters:
    - name: user_id
      type: string
    returns:
    - name: accepted
      type: boolean

  - name: set_adapters_debug
    type: function
    desc: Enables or disables mediated-network debug logging. Disable it in production.
    parameters:
    - name: enabled
      type: boolean

  - name: validate_integration
    type: function
    desc: Runs the native LevelPlay integration validator.

  - name: launch_test_suite
    type: function
    desc: Opens the LevelPlay integration test suite after initialization succeeds. Enable the is_test_suite metadata before init and call this before creating ad objects or invoking other LevelPlay SDK operations.

# App Tracking Transparency

  - name: request_tracking_authorization
    type: function
    desc: Requests App Tracking Transparency authorization on iOS 14 or newer. Request it before init when mediation partners should receive the IDFA. The result is sent through MSG_TRACKING. It is a no-op on Android and unsupported iOS versions.

  - name: get_tracking_authorization_status
    type: function
    desc: Returns the current App Tracking Transparency state on iOS, or nil when unsupported.
    returns:
    - name: status
      type: number
      optional: true
      desc: One of TRACKING_STATUS_NOT_DETERMINED, TRACKING_STATUS_RESTRICTED, TRACKING_STATUS_DENIED, or TRACKING_STATUS_AUTHORIZED.

# Interstitial ads

  - name: create_interstitial_ad
    type: function
    desc: Creates a reusable interstitial ad object after successful initialization. Its ad-unit ID and optional bid floor are fixed for the object's lifetime. Create it once, then use the returned handle for multiple load/show cycles with the same ad-unit ID and creation configuration.
    parameters:
    - name: ad_unit_id
      type: string
      desc: Interstitial ad-unit ID from the LevelPlay dashboard.
    - name: bid_floor
      type: number
      optional: true
      desc: Optional minimum eCPM in USD. It applies to every load by this object; changing it requires destroying the handle and creating a new object.
    returns:
    - name: handle
      type: number
      optional: true
      desc: Positive handle, or nil when native creation is rejected.

  - name: destroy_interstitial_ad
    type: function
    desc: Permanently releases an interstitial ad object, invalidates its handle, and stops callbacks for it. Do not destroy between ordinary impressions or during load/display when terminal callbacks are still required.
    parameters:
    - name: handle
      type: number

  - name: load_interstitial_ad
    type: function
    desc: Loads the next interstitial impression into an existing object. After an impression closes, call this again on the same handle instead of creating another object.
    parameters:
    - name: handle
      type: number

  - name: is_interstitial_ad_ready
    type: function
    desc: Returns whether the interstitial object has an ad ready to display.
    parameters:
    - name: handle
      type: number
    returns:
    - name: ready
      type: boolean

  - name: show_interstitial_ad
    type: function
    desc: Shows one loaded interstitial impression. The optional placement is a dashboard presentation point, not an ad object, and can be selected separately on every show.
    parameters:
    - name: handle
      type: number
    - name: placement
      type: string
      optional: true

  - name: is_interstitial_placement_capped
    type: function
    desc: Returns whether the named interstitial placement has reached its configured cap.
    parameters:
    - name: placement
      type: string
    returns:
    - name: capped
      type: boolean

# Rewarded ads

  - name: create_rewarded_ad
    type: function
    desc: Creates a reusable rewarded ad object after successful initialization. Its ad-unit ID and optional bid floor are fixed for the object's lifetime. Create it once, then use the returned handle for multiple load/show cycles with the same ad-unit ID and creation configuration.
    parameters:
    - name: ad_unit_id
      type: string
      desc: Rewarded ad-unit ID from the LevelPlay dashboard.
    - name: bid_floor
      type: number
      optional: true
      desc: Optional minimum eCPM in USD. It applies to every load by this object; changing it requires destroying the handle and creating a new object.
    returns:
    - name: handle
      type: number
      optional: true
      desc: Positive handle, or nil when native creation is rejected.

  - name: destroy_rewarded_ad
    type: function
    desc: Permanently releases a rewarded ad object, invalidates its handle, and stops callbacks for it. Do not destroy between ordinary impressions, and never destroy a displayed rewarded ad before its reward and close callbacks are received.
    parameters:
    - name: handle
      type: number

  - name: load_rewarded_ad
    type: function
    desc: Loads the next rewarded impression into an existing object. After reward and close callbacks complete, call this again on the same handle instead of creating another object.
    parameters:
    - name: handle
      type: number

  - name: is_rewarded_ad_ready
    type: function
    desc: Returns whether the rewarded object has an ad ready to display.
    parameters:
    - name: handle
      type: number
    returns:
    - name: ready
      type: boolean

  - name: show_rewarded_ad
    type: function
    desc: Shows one loaded rewarded impression. The optional placement is a dashboard presentation point, not an ad object, and can be selected separately on every show.
    parameters:
    - name: handle
      type: number
    - name: placement
      type: string
      optional: true

  - name: is_rewarded_placement_capped
    type: function
    desc: Returns whether the named rewarded placement has reached its configured cap.
    parameters:
    - name: placement
      type: string
    returns:
    - name: capped
      type: boolean

  - name: get_reward
    type: function
    desc: Returns the configured reward for the object's default placement or for the supplied placement.
    parameters:
    - name: handle
      type: number
    - name: placement
      type: string
      optional: true
    returns:
    - name: reward
      type: table
      optional: true
      fields:
      - name: name
        type: string
      - name: amount
        type: number

# Banner ads

  - name: create_banner_ad
    type: function
    desc: Creates a reusable banner ad view after successful initialization. Its ad-unit ID and all options are fixed for the view's lifetime. Create it once, then load, hide, show, and auto-refresh the same handle until it is permanently destroyed.
    parameters:
    - name: ad_unit_id
      type: string
      desc: Banner ad-unit ID from the LevelPlay dashboard.
    - name: options
      type: table
      optional: true
      desc: Creation-time banner configuration. These fields apply to every load and show; changing one requires destroying the handle and creating a new banner.
      fields:
      - name: size
        type: number
        optional: true
        desc: A BANNER_SIZE_* constant. Defaults to BANNER_SIZE_ADAPTIVE.
      - name: position
        type: number
        optional: true
        desc: BANNER_POSITION_TOP or BANNER_POSITION_BOTTOM. Defaults to BANNER_POSITION_BOTTOM.
      - name: placement
        type: string
        optional: true
        desc: Dashboard placement used for reporting by this banner object.
      - name: bid_floor
        type: number
        optional: true
        desc: Minimum eCPM in USD applied to every load by this banner object.
      - name: respect_safe_area
        type: boolean
        optional: true
        desc: Whether the banner avoids system bars and display cutouts. Defaults to true.
    returns:
    - name: handle
      type: number
      optional: true
      desc: Positive handle, or nil when native creation is rejected.

  - name: load_banner_ad
    type: function
    desc: Loads and displays a banner because the native LevelPlay banner view is visible by default.
    parameters:
    - name: handle
      type: number

  - name: show_banner_ad
    type: function
    desc: Makes the banner view visible.
    parameters:
    - name: handle
      type: number

  - name: hide_banner_ad
    type: function
    desc: Hides the banner without destroying it.
    parameters:
    - name: handle
      type: number

  - name: pause_banner_auto_refresh
    type: function
    desc: Pauses automatic refresh for the banner.
    parameters:
    - name: handle
      type: number

  - name: resume_banner_auto_refresh
    type: function
    desc: Resumes automatic refresh for the banner.
    parameters:
    - name: handle
      type: number

  - name: destroy_banner_ad
    type: function
    desc: Removes and destroys the banner view and invalidates its handle.
    parameters:
    - name: handle
      type: number

# Message constants

  - name: MSG_INIT
    type: number
    desc: Initialization events.

  - name: MSG_INTERSTITIAL
    type: number
    desc: Interstitial-object events.

  - name: MSG_REWARDED
    type: number
    desc: Rewarded-object events.

  - name: MSG_BANNER
    type: number
    desc: Banner-object events.

  - name: MSG_TRACKING
    type: number
    desc: App Tracking Transparency status events.

# Event constants

  - name: EVENT_INIT_SUCCEEDED
    type: number

  - name: EVENT_INIT_FAILED
    type: number

  - name: EVENT_AD_LOADED
    type: number

  - name: EVENT_AD_LOAD_FAILED
    type: number

  - name: EVENT_AD_INFO_CHANGED
    type: number

  - name: EVENT_AD_DISPLAYED
    type: number

  - name: EVENT_AD_DISPLAY_FAILED
    type: number

  - name: EVENT_AD_CLICKED
    type: number

  - name: EVENT_AD_CLOSED
    type: number

  - name: EVENT_AD_REWARDED
    type: number

  - name: EVENT_AD_EXPANDED
    type: number

  - name: EVENT_AD_COLLAPSED
    type: number

  - name: EVENT_AD_LEFT_APPLICATION
    type: number

  - name: EVENT_JSON_ERROR
    type: number

# Tracking-status constants

  - name: TRACKING_STATUS_NOT_DETERMINED
    type: number

  - name: TRACKING_STATUS_RESTRICTED
    type: number

  - name: TRACKING_STATUS_DENIED
    type: number

  - name: TRACKING_STATUS_AUTHORIZED
    type: number

# Banner constants

  - name: BANNER_SIZE_BANNER
    type: number

  - name: BANNER_SIZE_LARGE
    type: number

  - name: BANNER_SIZE_MEDIUM_RECTANGLE
    type: number

  - name: BANNER_SIZE_LEADERBOARD
    type: number

  - name: BANNER_SIZE_ADAPTIVE
    type: number

  - name: BANNER_POSITION_TOP
    type: number

  - name: BANNER_POSITION_BOTTOM
    type: number
